{
  "hosting": {
    "public": "askchuck-frontend/out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {"source": "/", "destination": "/chat", "type": 301}
    ],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  }
}
