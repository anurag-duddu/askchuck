# ============================================
# AskChuck Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to version control!
# Get API keys from the links provided below

# ============================================
# LLM Provider (Groq)
# ============================================
# Get your API key from: https://console.groq.com/
# Free tier: 14,400 requests/day
GROQ_API_KEY=gsk_your_groq_api_key_here

# ============================================
# Embeddings (Voyage AI)
# ============================================
# Get your API key from: https://www.voyageai.com/
# Free tier: 200M tokens/month
VOYAGE_API_KEY=pa-your_voyage_api_key_here

# ============================================
# Vector Database (Pinecone)
# ============================================
# Get your API key from: https://app.pinecone.io/
# Free tier: 2GB storage, unlimited queries
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=askchuck

# ============================================
# Reranking (Cohere)
# ============================================
# Get your API key from: https://dashboard.cohere.com/
# Free tier: 1,000 calls/month
COHERE_API_KEY=your_cohere_api_key_here

# ============================================
# Storage & Database (Supabase)
# ============================================
# Get credentials from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
# Free tier: 1GB storage, 50,000 monthly active users, unlimited API requests
# Used for: Figure storage (now) + Chat history & user data (Next.js migration)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_service_role_key_here_starts_with_eyJ
SUPABASE_ANON_KEY=your_anon_key_here_starts_with_eyJ
SUPABASE_STORAGE_BUCKET=askchuck-figures

# ============================================
# Observability (LangSmith)
# ============================================
# Get your API key from: https://smith.langchain.com/
# Free tier: 5,000 traces/month
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_your_langsmith_api_key_here
LANGCHAIN_PROJECT=askchuck
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================
# Optional: Authentication (Clerk)
# ============================================
# Get your keys from: https://clerk.com/
# Free tier: 10,000 monthly active users
# NOTE: Only needed for Next.js frontend
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ============================================
# Application Settings
# ============================================
# Environment: development or production
APP_ENV=development

# Enable debug logging
DEBUG=true

# Port for FastAPI server
PORT=8000

# CORS allowed origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
